{
    "name": "ecom-demo",
    "version": "1.0.0",
    "description": "eCom with MERN",
    "homepage": "https://github.com/PoChuanSu/BootCamp-ECOM#readme",
    "bugs": {
        "url": "https://github.com/PoChuanSu/BootCamp-ECOM/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PoChuanSu/BootCamp-ECOM.git"
    },
    "license": "ISC",
    "author": "",
    "type": "module",
    "main": "server.js",
    "scripts": {
        "server": "nodemon backend/server.js",
        "client": "npm start --prefix frontend",
        "dev": "concurrently \"npm run server\" \"npm run client\"",
        "data:import": "node backend/seeder.js",
        "data:destroy": "node backend/seeder.js -d",
        "build": "npm install --prefix frontend && npm run build --prefix frontend"
    },
    "dependencies": {
        "bcrypt": "^5.1.1",
        "color": "^4.2.3",
        "colors": "^1.4.0",
        "concurrently": "^9.1.2",
        "cookie-parser": "^1.4.7",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.9.5",
        "multer": "^1.4.5-lts.1",
        "swiper": "^12.0.3"
    }
}
